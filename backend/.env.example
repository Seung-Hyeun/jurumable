# Copy to .env for local development (.env stays out of Git).
# In production, set these in the hosting provider instead.

# PostgreSQL connection string (Prisma CLI and the app).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# The only browser origin REST and Socket.IO CORS allow: the frontend URL
# (scheme + host + port, no trailing slash). Defaults to http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000

# HTTP port. Hosting providers usually set it themselves. Defaults to 3001.
PORT=3001
